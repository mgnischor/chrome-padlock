{
    "name": "padlock-password-generator",
    "version": "1.0.0",
    "private": true,
    "description": "Chrome extension that generates cryptographically secure passwords.",
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "icons": "node scripts/make-icons.mjs",
        "check": "npm run typecheck && npm test && npm run build"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.326",
        "@types/node": "^22.20.5",
        "esbuild": "^0.25.0",
        "typescript": "^5.8.0",
        "vitest": "^3.2.0"
    }
}
